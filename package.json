{
  "name": "daybook",
  "productName": "Daybook",
  "version": "1.0.0",
  "description": "A notebook-style desktop app combining task management with recurring reminders and nutrition tracking.",
  "main": "electron/main.js",
  "author": "Daybook",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "tesseract.js": "^7.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "build": {
    "appId": "com.daybook.app",
    "productName": "Daybook",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
